{
  "id": "atlan-openapi",
  "name": "OpenAPI Spec Loader",
  "logo": "http://assets.atlan.com/assets/apispec.png",
  "config": {
    "properties": {
      "import_type": {
        "type": "string",
        "required": true,
        "ui": {
          "widget": "radio",
          "label": "Import type",
          "hidden": false,
          "help": "",
          "grid": 8
        },
        "default": "URL",
        "enum": [
          "URL",
          "CLOUD"
        ],
        "enumNames": [
          "URL",
          "Cloud"
        ]
      },
      "spec_url": {
        "type": "string",
        "required": true,
        "ui": {
          "widget": "input",
          "label": "Spec URL",
          "hidden": false,
          "help": "",
          "placeholder": "https://petstore3.swagger.io/api/v3/openapi.json",
          "grid": 8
        }
      },
      "spec_file": {
        "type": "string",
        "required": false,
        "ui": {
          "widget": "fileUpload",
          "label": "Spec file",
          "hidden": true,
          "help": "",
          "placeholder": "",
          "grid": 8,
          "accept": [
            "application/json",
            "application/zip",
            "application/x-yaml",
            "text/yaml"
          ],
          "fileMetadata": true
        }
      },
      "spec_prefix": {
        "type": "string",
        "required": false,
        "ui": {
          "widget": "input",
          "label": "Object store path",
          "hidden": false,
          "help": "",
          "placeholder": "path/to/file",
          "grid": 4
        }
      },
      "spec_key": {
        "type": "string",
        "required": false,
        "ui": {
          "widget": "input",
          "label": "Object key",
          "hidden": false,
          "help": "",
          "placeholder": "openapi.json",
          "grid": 4
        }
      },
      "cloud_source": {
        "type": "string",
        "required": true,
        "ui": {
          "widget": "credential",
          "label": "Cloud source",
          "hidden": false,
          "help": "",
          "grid": 8,
          "credentialType": "csa-connectors-objectstore",
          "isTestAuthenticationDisabled": true
        }
      },
      "connection_usage": {
        "type": "string",
        "required": true,
        "ui": {
          "widget": "radio",
          "label": "Connection usage",
          "hidden": false,
          "help": "",
          "grid": 8
        },
        "default": "REUSE",
        "enum": [
          "CREATE",
          "REUSE"
        ],
        "enumNames": [
          "Create",
          "Reuse"
        ]
      },
      "connection": {
        "type": "string",
        "required": true,
        "ui": {
          "widget": "connection",
          "label": "Connection",
          "hidden": false,
          "help": "",
          "grid": 8
        }
      },
      "connection_qualified_name": {
        "type": "string",
        "required": true,
        "ui": {
          "widget": "connectionSelector",
          "label": "Connection",
          "hidden": false,
          "help": "",
          "grid": 4,
          "mode": "",
          "start": 1,
          "connectorName": "api"
        }
      }
    },
    "anyOf": [
      {
        "properties": {
          "import_type": {
            "const": "URL"
          }
        },
        "required": [
          "spec_url"
        ]
      },
      {
        "properties": {
          "import_type": {
            "const": "CLOUD"
          }
        },
        "required": [
          "cloud_source",
          "spec_prefix",
          "spec_key"
        ]
      },
      {
        "properties": {
          "import_type": {
            "const": "DIRECT"
          }
        },
        "required": [
          "spec_file"
        ]
      },
      {
        "properties": {
          "connection_usage": {
            "const": "REUSE"
          }
        },
        "required": [
          "connection_qualified_name"
        ]
      },
      {
        "properties": {
          "connection_usage": {
            "const": "CREATE"
          }
        },
        "required": [
          "connection"
        ]
      }
    ],
    "steps": [
      {
        "title": "Configuration",
        "description": "OpenAPI spec configuration",
        "id": "configuration",
        "properties": [
          "import_type",
          "spec_url",
          "spec_file",
          "spec_prefix",
          "spec_key",
          "cloud_source"
        ]
      },
      {
        "title": "Connection",
        "description": "Connection details",
        "id": "connection",
        "properties": [
          "connection_usage",
          "connection",
          "connection_qualified_name"
        ]
      }
    ]
  }
}
