amends "@app-contract-toolkit/App.pkl"

// conformance: ignore[K002] Connectors.* has no typealias re-export in App.pkl (only Widgets.* does); `pkl eval` fails without this import.
import "@app-contract-toolkit/Connectors.pkl"

name = "openapi"
displayName = "OpenAPI Spec Loader"
connector = Connectors.API
icon = "http://assets.atlan.com/assets/apispec.png"
workflowType = name
hasCredentialConfig = false
metadata { ["release_model"] = "semver" }

pipeline {
  extract = new ExtractStep {
    errorHandling = new ErrorHandlingConfig {
      startToCloseTimeoutSeconds = 86400
    }
  }
}

uiConfig = new UIConfig {
  tasks {
    ["Configuration"] {
      description = "OpenAPI spec configuration"
      inputs {
        // Hidden manifest-only field (P029 / DISTR-752): Heracles/AE derives
        // agent-vs-direct credential routing from `extraction_method` at
        // dispatch. This app has one fixed extraction path (task-based, no
        // agent-mode toggle), so the value is a constant, not a user choice.
        ["extraction_method"] = new TextInput {
          title = "Extraction method"
          hide = true
          default = "direct"
        }
        ["import_type"] = new Radio {
          title = "Import type"
          helpText = "How to provide the spec: 'URL' (HTTP fetch) or 'CLOUD' (object storage)."
          possibleValues { ["URL"] = "URL"; ["CLOUD"] = "Cloud" }
          default = "URL"
          required = true
        }
        ["spec_url"] = new TextInput {
          title = "Spec URL"
          helpText = "URL to the OpenAPI spec JSON/YAML document. Required when import_type='URL'."
          required = true
          placeholderText = "https://petstore3.swagger.io/api/v3/openapi.json"
        }
        ["spec_prefix"] = new TextInput {
          title = "Object store path"
          helpText = "Object store directory path. Required when import_type='CLOUD'."
          width = 4
          placeholderText = "path/to/file"
        }
        ["spec_key"] = new TextInput {
          title = "Object key"
          helpText = "Object key (filename) in the object store. Required when import_type='CLOUD'."
          width = 4
          placeholderText = "openapi.json"
        }
        ["cloud_source"] = new CredentialInput {
          title = "Cloud source"
          helpText = "Cloud storage credential (csa-connectors-objectstore). Required when import_type='CLOUD'."
          required = true
          credType = "csa-connectors-objectstore"
          allowTestAuthentication = false
        }
      }
    }
    ["Connection"] {
      description = "Connection details"
      inputs {
        ["connection"] = new ConnectionCreator {
          title = "Connection"
          helpText = "Atlan connection to create or reuse."
          required = true
        }
      }
    }
  }
  rules {
    new UIRule {
      whenInputs { ["import_type"] = "URL" }
      required { "spec_url" }
    }
    new UIRule {
      whenInputs { ["import_type"] = "CLOUD" }
      required { "cloud_source"; "spec_prefix"; "spec_key" }
    }
  }
}
