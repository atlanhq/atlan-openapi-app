amends "@app-contract-toolkit/NativeApp.pkl"

import "@app-contract-toolkit/Config.pkl"
import "@app-contract-toolkit/Connectors.pkl"

name = "openapi"
displayName = "OpenAPI Spec Loader"
connector = Connectors.API
icon = "http://assets.atlan.com/assets/apispec.png"
workflowType = name
hasCredentialConfig = false

uiConfig {
  tasks {
    ["Configuration"] {
      description = "OpenAPI spec configuration"
      inputs {
        ["import_type"] = new Config.Radio {
          title = "Import type"
          helpText = "How to provide the spec: 'URL' (HTTP fetch), 'CLOUD' (object storage), 'DIRECT' (UI file upload)."
          possibleValues { ["URL"] = "URL"; ["CLOUD"] = "Cloud"; ["DIRECT"] = "Direct" }
          default = "URL"
          required = true
        }
        ["spec_url"] = new Config.TextInput {
          title = "Spec URL"
          helpText = "URL to the OpenAPI spec JSON/YAML document. Required when import_type='URL'."
          required = true
          placeholderText = "https://petstore3.swagger.io/api/v3/openapi.json"
        }
        ["spec_file"] = new Config.FileUploader {
          title = "Spec file"
          helpText = "Uploaded file reference. Required when import_type='DIRECT'."
          hide = true
          fileTypes { "application/json"; "application/zip"; "application/x-yaml"; "text/yaml" }
        }
        ["spec_prefix"] = new Config.TextInput {
          title = "Object store path"
          helpText = "Object store directory path. Required when import_type='CLOUD'."
          width = 4
          placeholderText = "path/to/file"
        }
        ["spec_key"] = new Config.TextInput {
          title = "Object key"
          helpText = "Object key (filename) in the object store. Required when import_type='CLOUD'."
          width = 4
          placeholderText = "openapi.json"
        }
        ["cloud_source"] = new Config.CredentialInput {
          title = "Cloud source"
          helpText = "Cloud storage credential (csa-connectors-objectstore). Required when import_type='CLOUD'."
          required = true
          credType = "csa-connectors-objectstore"
          allowTestAuthentication = false
        }
      }
    }
    ["Connection"] {
      description = "Connection details"
      inputs {
        ["connection_usage"] = new Config.Radio {
          title = "Connection usage"
          helpText = "'CREATE' to make a new connection, 'REUSE' to pick an existing one."
          possibleValues { ["CREATE"] = "Create"; ["REUSE"] = "Reuse" }
          default = "REUSE"
          required = true
        }
        ["connection"] = new Config.ConnectionCreator {
          title = "Connection"
          helpText = "Atlan connection to create. Required when connection_usage='CREATE'."
          required = true
        }
        ["connection_qualified_name"] = new Config.ConnectionSelector {
          title = "Connection"
          helpText = "Existing connection qualified name. Required when connection_usage='REUSE'."
          required = true
          width = 4
          connectorFilter = "api"
        }
      }
    }
  }
  rules {
    new Config.UIRule {
      whenInputs { ["import_type"] = "URL" }
      required { "spec_url" }
    }
    new Config.UIRule {
      whenInputs { ["import_type"] = "CLOUD" }
      required { "cloud_source"; "spec_prefix"; "spec_key" }
    }
    new Config.UIRule {
      whenInputs { ["import_type"] = "DIRECT" }
      required { "spec_file" }
    }
    new Config.UIRule {
      whenInputs { ["connection_usage"] = "REUSE" }
      required { "connection_qualified_name" }
    }
    new Config.UIRule {
      whenInputs { ["connection_usage"] = "CREATE" }
      required { "connection" }
    }
  }
}

manifestTopLevelArgs {
  ["connection"] = "connection"
}
