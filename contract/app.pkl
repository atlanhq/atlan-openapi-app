amends "@app-contract-toolkit/NativeApp.pkl"

import "@app-contract-toolkit/Config.pkl"
import "@app-contract-toolkit/Connectors.pkl"

name = "openapi"
displayName = "OpenAPI Spec Loader"
connector = Connectors.API
icon = "http://assets.atlan.com/assets/apispec.png"
workflowType = name
hasCredentialConfig = false
flatManifestArgs = true

uiConfig {
  tasks {
    ["Configuration"] {
      description = "OpenAPI spec configuration"
      inputs {
        ["import_type"] = new Config.Radio {
          title = "Import type"
          helpText = "How to provide the spec: 'URL' (HTTP fetch) or 'CLOUD' (object storage)."
          possibleValues { ["URL"] = "URL"; ["CLOUD"] = "Cloud" }
          default = "URL"
          required = true
        }
        ["spec_url"] = new Config.TextInput {
          title = "Spec URL"
          helpText = "URL to the OpenAPI spec JSON/YAML document. Required when import_type='URL'."
          required = true
          placeholderText = "https://petstore3.swagger.io/api/v3/openapi.json"
        }
["spec_prefix"] = new Config.TextInput {
          title = "Object store path"
          helpText = "Object store directory path. Required when import_type='CLOUD'."
          width = 4
          placeholderText = "path/to/file"
        }
        ["spec_key"] = new Config.TextInput {
          title = "Object key"
          helpText = "Object key (filename) in the object store. Required when import_type='CLOUD'."
          width = 4
          placeholderText = "openapi.json"
        }
        ["cloud_source"] = new Config.CredentialInput {
          title = "Cloud source"
          helpText = "Cloud storage credential (csa-connectors-objectstore). Required when import_type='CLOUD'."
          required = true
          credType = "csa-connectors-objectstore"
          allowTestAuthentication = false
        }
      }
    }
    ["Connection"] {
      description = "Connection details"
      inputs {
        ["connection"] = new Config.ConnectionCreator {
          title = "Connection"
          helpText = "Atlan connection to create or reuse."
          required = true
        }
      }
    }
  }
  rules {
    new Config.UIRule {
      whenInputs { ["import_type"] = "URL" }
      required { "spec_url" }
    }
    new Config.UIRule {
      whenInputs { ["import_type"] = "CLOUD" }
      required { "cloud_source"; "spec_prefix"; "spec_key" }
    }
  }
}

manifestTopLevelArgs {
  ["connection"] = "connection"
}

// ---------------------------------------------------------------------------
// publish-app cache + current-state flags (WARE-1384 / Argo→publish-app
// migration). Mirrors the same block already on exec_mode_demo (PR #85).
// Routes the connection-cache SQLite + current-state diff base through
// publish-app activities so cross-connection consumers (lineage-app's
// LineageFilter, popularity-app, downstream miners) read a fresh cache +
// state on every run. Without these, publish-app falls back to env-var
// defaults (constants.py:78-82) which skip cache build and write
// current-state to a -dry-run suffixed key.
// ---------------------------------------------------------------------------

extraNodes {
  ["publish"] = new PublishNode {
    args {
      ["connection_cache_enabled"] = true
      ["connection_cache_via_app_enabled"] = true
      ["current_state_enabled"] = true
      ["current_state_via_app_enabled"] = true
    }
  }
}
