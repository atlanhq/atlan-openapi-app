{
  "id": "openapi",
  "name": "OpenAPI Spec Loader",
  "logo": "http://assets.atlan.com/assets/apispec.png",
  "config": {
    "properties": {
      "extraction_method": {
        "type": "string",
        "required": false,
        "ui": {
          "widget": "input",
          "label": "Extraction method",
          "hidden": true,
          "help": "",
          "placeholder": "",
          "grid": 8
        },
        "default": "direct"
      },
      "import_type": {
        "type": "string",
        "required": false,
        "ui": {
          "widget": "radio",
          "label": "Import spec from",
          "hidden": false,
          "help": "Select how you want to provide the OpenAPI spec file to be imported.",
          "grid": 8
        },
        "default": "URL",
        "enum": [
          "URL",
          "CLOUD"
        ],
        "enumNames": [
          "URL",
          "Object storage"
        ]
      },
      "spec_url": {
        "type": "string",
        "required": true,
        "ui": {
          "widget": "input",
          "label": "Specification URL",
          "hidden": false,
          "help": "Full URL to the JSON form of the OpenAPI specification.",
          "placeholder": "https://petstore3.swagger.io/api/v3/openapi.json",
          "grid": 8
        }
      },
      "spec_file": {
        "type": "string",
        "required": false,
        "ui": {
          "widget": "fileUpload",
          "label": "Spec file",
          "hidden": true,
          "help": "Select the OpenAPI spec file containing metadata to import.",
          "placeholder": "Select OpenAPI JSON or ZIP file",
          "grid": 8,
          "accept": [
            "application/json",
            "application/zip",
            "application/yaml"
          ],
          "fileMetadata": true
        }
      },
      "spec_prefix": {
        "type": "string",
        "required": false,
        "ui": {
          "widget": "input",
          "label": "Prefix (path)",
          "hidden": false,
          "help": "Enter the directory (path) within the object store from which to retrieve the OpenAPI spec file.",
          "placeholder": "path/to/file",
          "grid": 4
        }
      },
      "spec_key": {
        "type": "string",
        "required": false,
        "ui": {
          "widget": "input",
          "label": "Object key (filename)",
          "hidden": false,
          "help": "Enter the object key (filename), including its extension, within the object store and prefix.",
          "placeholder": "openapi.json",
          "grid": 4
        }
      },
      "cloud_source": {
        "type": "string",
        "required": true,
        "ui": {
          "widget": "credential",
          "label": "Import spec from",
          "hidden": false,
          "help": "Enter details for the object store from which to retrieve the OpenAPI spec containing metadata to be imported.",
          "grid": 8,
          "credentialType": "csa-connectors-objectstore",
          "isTestAuthenticationDisabled": true
        }
      },
      "connection_usage": {
        "type": "string",
        "required": true,
        "ui": {
          "widget": "radio",
          "label": "Connection",
          "hidden": false,
          "help": "Whether to create a new connection to hold these API assets, or reuse an existing connection.",
          "grid": 8
        },
        "default": "REUSE",
        "enum": [
          "CREATE",
          "REUSE"
        ],
        "enumNames": [
          "Create",
          "Reuse"
        ]
      },
      "connection": {
        "type": "string",
        "required": true,
        "ui": {
          "widget": "connection",
          "label": "Connection",
          "hidden": false,
          "help": "Enter details for a new connection to be created.",
          "grid": 8
        }
      },
      "connection_qualified_name": {
        "type": "string",
        "required": true,
        "ui": {
          "widget": "connectionSelector",
          "label": "Connection",
          "hidden": false,
          "help": "Select an existing connection to load assets into.",
          "grid": 4,
          "mode": "",
          "start": 1,
          "connectorName": "api"
        }
      }
    },
    "anyOf": [
      {
        "properties": {
          "import_type": {
            "const": "URL"
          }
        },
        "required": [
          "spec_url"
        ]
      },
      {
        "properties": {
          "import_type": {
            "const": "CLOUD"
          }
        },
        "required": [
          "cloud_source",
          "spec_prefix",
          "spec_key"
        ]
      },
      {
        "properties": {
          "import_type": {
            "const": "DIRECT"
          }
        },
        "required": [
          "spec_file"
        ]
      },
      {
        "properties": {
          "connection_usage": {
            "const": "REUSE"
          }
        },
        "required": [
          "connection_qualified_name"
        ]
      },
      {
        "properties": {
          "connection_usage": {
            "const": "CREATE"
          }
        },
        "required": [
          "connection"
        ]
      }
    ],
    "steps": [
      {
        "title": "Configuration",
        "description": "OpenAPI spec configuration",
        "id": "configuration",
        "properties": [
          "extraction_method",
          "import_type",
          "spec_url",
          "spec_file",
          "spec_prefix",
          "spec_key",
          "cloud_source"
        ]
      },
      {
        "title": "Connection",
        "description": "Connection details",
        "id": "connection",
        "properties": [
          "connection_usage",
          "connection",
          "connection_qualified_name"
        ]
      }
    ]
  }
}
