{
  "id": "openapi",
  "name": "OpenAPI Spec Loader",
  "logo": "http://assets.atlan.com/assets/apispec.png",
  "config": {
    "properties": {
      "extraction_method": {
        "type": "string",
        "required": false,
        "ui": {
          "widget": "input",
          "label": "Extraction method",
          "hidden": true,
          "help": "",
          "placeholder": "",
          "grid": 8
        },
        "default": "direct"
      },
      "connection_usage": {
        "type": "string",
        "required": true,
        "ui": {
          "widget": "radio",
          "label": "Connection",
          "hidden": false,
          "help": "Whether to create a new connection to hold these API assets, or reuse an existing connection.",
          "grid": 8
        },
        "default": "REUSE",
        "enum": [
          "CREATE",
          "REUSE"
        ],
        "enumNames": [
          "Create",
          "Reuse"
        ]
      },
      "connection": {
        "type": "string",
        "required": true,
        "ui": {
          "widget": "connection",
          "label": "Connection",
          "hidden": false,
          "help": "Enter details for a new connection to be created.",
          "grid": 8,
          "connector": "api"
        }
      },
      "connection_qualified_name": {
        "type": "string",
        "required": true,
        "ui": {
          "widget": "connectionSelector",
          "label": "Connection",
          "hidden": false,
          "help": "Select an existing connection to load assets into.",
          "grid": 4,
          "mode": "",
          "start": 1,
          "connectorName": "api"
        }
      }
    },
    "anyOf": [
      {
        "properties": {
          "connection_usage": {
            "const": "REUSE"
          }
        },
        "required": [
          "connection_qualified_name"
        ]
      },
      {
        "properties": {
          "connection_usage": {
            "const": "CREATE"
          }
        },
        "required": [
          "connection"
        ]
      }
    ],
    "steps": [
      {
        "title": "Configuration",
        "description": "OpenAPI spec configuration",
        "id": "configuration",
        "properties": [
          "extraction_method"
        ]
      },
      {
        "title": "Connection",
        "description": "Connection details",
        "id": "connection",
        "properties": [
          "connection_usage",
          "connection",
          "connection_qualified_name"
        ]
      }
    ]
  }
}
